{
  "name": "strapi-plugin-recycle-bin",
  "version": "1.0.4",
  "description": "Safely intercept content deletions in Strapi 5 with a soft-delete recycle bin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kaushik-Patil-biradar/-recyclebin-.git"
  },
  "bugs": {
    "url": "https://github.com/Kaushik-Patil-biradar/-recyclebin-/issues"
  },
  "homepage": "https://github.com/Kaushik-Patil-biradar/-recyclebin-#readme",
  "keywords": [
    "strapi",
    "strapi-plugin",
    "recycle-bin",
    "soft-delete",
    "trash",
    "restore",
    "document-service"
  ],
  "type": "commonjs",
  "license": "MIT",
  "author": {
    "name": "Gigasolv",
    "email": "hello@gigasolv.com"
  },
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "types": "./dist/admin/src/index.d.ts",
      "source": "./admin/src/index.ts",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "types": "./dist/server/src/index.d.ts",
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "strapi-plugin build",
    "watch": "strapi-plugin watch",
    "watch:link": "strapi-plugin watch:link",
    "verify": "strapi-plugin verify",
    "test:ts:front": "tsc -p admin/tsconfig.json",
    "test:ts:back": "tsc -p server/tsconfig.json",
    "test": "jest --forceExit --detectOpenHandles"
  },
  "devDependencies": {
    "@strapi/design-system": "^2.2.4",
    "@strapi/icons": "^2.2.4",
    "@strapi/sdk-plugin": "^6.1.1",
    "@strapi/strapi": "^5.57.0",
    "@strapi/typescript-utils": "^5.57.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intl": "^6.8.9",
    "react-router-dom": "^6.30.6",
    "styled-components": "^6.5.3",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@strapi/design-system": "^2.0.0",
    "@strapi/icons": "^2.0.0",
    "@strapi/strapi": "^5.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-intl": "^6.0.0",
    "react-router-dom": "^6.0.0",
    "styled-components": "^6.0.0"
  },
  "strapi": {
    "kind": "plugin",
    "name": "recycle-bin",
    "displayName": "Recycle Bin",
    "description": "Safely intercept content deletions in Strapi 5 with a soft-delete recycle bin"
  }
}